# Verbindung zur Neon-Datenbank.
# Zu finden in der Neon-Oberflaeche unter Connect, "Connection string".
# Diese Datei ist nur die Vorlage. Die echte Verbindung gehoert in .env.local,
# die nicht in Git landet.
DATABASE_URL=postgresql://benutzer:passwort@host.neon.tech/eventmanager?sslmode=require

# Adresse, unter der das Programm erreichbar ist. Wird fuer die persoenlichen
# Angebotslinks gebraucht, die der Kunde in der Mail bekommt.
APP_URL=http://localhost:3005

# lexoffice, sobald der Schluessel vorliegt.
LEXOFFICE_API_KEY=

# Ditix-Zwischenserver, sobald der eigene Zugang von Julian da ist.
DITIX_API_URL=
DITIX_API_KEY=

# Adresse des Ticketshops. Wird nur LESEND verwendet, um den Spielplan zu holen.
SHOP_API_URL=https://shop.florianzimmertheater.de

# Unterschrift fuer die Anmelde-Cookies, mindestens 32 Zeichen.
# Einen eigenen Wert erzeugen: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Mailversand über das Microsoft-365-Postfach.
# Die ersten beiden Werte stehen in Entra auf der Übersichtsseite der
# App-Registrierung "FZT Eventmanager". Das Geheimnis wird dort unter
# "Zertifikate & Geheimnisse" erzeugt und nur ein einziges Mal angezeigt.
MS_MANDANT_ID=
MS_ANWENDUNG_ID=
MS_GEHEIMNIS=
MAIL_ABSENDER=tickets@florianzimmer.com
# Aus welchem Postfach die Mails an die eigenen Mitarbeiter kommen:
# Arbeitsvertrag, Dienstplan, Stempeluhr. Bleibt es leer, kommen sie
# weiter aus dem Ticketpostfach. Bitte ein Postfach, das jemand liest,
# kein noreply: In der Vertragsmail steht ausdruecklich, man solle sich
# melden, bevor man unterschreibt.
MAIL_ABSENDER_PERSONAL=
# Wohin Antworten darauf gehen, falls nicht an dasselbe Postfach.
MAIL_ANTWORT_PERSONAL=

# Claude API, fuer den Scanner und HOERE ZU (Stichwort-Erkennung).
ANTHROPIC_API_KEY=

# Vercel Blob, fuer die Videos bei Tipps & Tricks.
# Im Vercel-Projekt unter "Storage" einen Blob-Store erstellen und mit
# diesem Projekt verbinden, dann setzt Vercel diese Variable dort selbst.
# Fuer die lokale Entwicklung den Wert danach mit "vercel env pull .env.local"
# holen oder von Hand aus der Vercel-Oberflaeche eintragen.
BLOB_READ_WRITE_TOKEN=

# Amazon Business, fuer die Rechnungen aus dem Geschaeftskonto.
# Aus der Amazon-Business-Entwicklerkonsole: eine Anwendung mit der Rolle
# "Business Purchase Reconciliation" und dem Document-Zugriff, danach
# einmal autorisieren und das Refresh-Token hier eintragen. Ohne diese
# Werte bleibt der Abgleich einfach aus.
AMAZON_BUSINESS_CLIENT_ID=
AMAZON_BUSINESS_CLIENT_SECRET=
AMAZON_BUSINESS_REFRESH_TOKEN=
# eu (Standard), na oder fe.
AMAZON_BUSINESS_REGION=eu
# Marktplatz, Standard ist amazon.de.
AMAZON_BUSINESS_MARKTPLATZ=A1PA6795UKMFR9
