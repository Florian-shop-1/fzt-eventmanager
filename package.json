    "test:datenbank": "tsx scripts/test-datenbank.ts",
    "test": "npm run test:sitzplan && npm run test:angebot && npm run test:datenbank",
    "db:status": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/db-status.ts",
    "lexoffice:test": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/lexoffice-test.ts",
    "test:menueliste": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/test-menueliste.ts",
